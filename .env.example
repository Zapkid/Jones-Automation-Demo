# Copy to `.env` (gitignored) to override defaults.

# Target env when --env is not passed: local | prod
ENV=prod

# Override the base URL of the site under test (any env).
# JONES_BASE_URL=https://test.netlify.app

# Port for the bundled mock site used by --env=local.
# JONES_MOCK_PORT=8765

# Optional Playwright browser channel (e.g. chrome, msedge).
# JONES_BROWSER_CHANNEL=
